{
  "title": "pipeline-devops-app",
  "uid": "pipeline-devops-app",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requests por segundo",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }] },
    { "id": 2, "type": "timeseries", "title": "Latencia p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }] },
    { "id": 3, "type": "timeseries", "title": "CPU del proceso",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "{{instance}}" }] },
    { "id": 4, "type": "stat", "title": "Errores 5xx (últ. 5m)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(increase(http_requests_total{status=~\"5..\"}[5m]))" }] }
  ]
}
